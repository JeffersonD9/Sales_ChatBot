# ══════════════════════════════════════════════════════
#  WhatsApp SaaS — Variables de entorno (PRODUCCIÓN)
#  Copiar a .env y completar con valores reales.
#
#  Para desarrollo con Docker, usar .env.dev.example en su lugar.
# ══════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# ── Base de datos ─────────────────────────────────────────────────────────────
# host = nombre del servicio Docker (postgres)
DATABASE_URL=postgresql://app:CHANGE_PASSWORD@postgres:5432/whatsapp_saas
DB_PASSWORD=CHANGE_PASSWORD                    # mismo password que DATABASE_URL

# ── Redis ─────────────────────────────────────────────────────────────────────
# La URL incluye la contraseña: redis://:PASSWORD@redis:6379
# Generar: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
REDIS_PASSWORD=your_redis_password_here
REDIS_URL=redis://:your_redis_password_here@redis:6379

# ── Seguridad ─────────────────────────────────────────────────────────────────
# Secret de tu Meta App (developers.facebook.com → App → Configuración básica → Secreto)
META_APP_SECRET=your_meta_app_secret_here

# AES-256 para encriptar wa_token en tabla tenants (32 bytes en hex = 64 chars)
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_64_char_hex_key_here

# pgcrypto para tenant_whatsapp_config (mínimo 32 caracteres)
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=your_app_secret_here

# API key para /admin/* (solo tú)
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=your_admin_api_key_here

# Firma JWT para tokens de tenant en /api/whatsapp/*
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# ── Demo mode ─────────────────────────────────────────────────────────────────
# true = sin DB ni Meta API, útil para demos a clientes
DEMO_MODE=false

# Configuración del tenant demo (solo aplica con DEMO_MODE=true)
DEMO_SLUG=demo-store
DEMO_BUSINESS_NAME=Glamour Store (Demo)
DEMO_OWNER_PHONE=573001234567
DEMO_CITY=Bucaramanga
DEMO_SCHEDULE=Lun-Sab 9am-7pm

# ── Email (opcional) ──────────────────────────────────────────────────────────
# Solo se inicializa si SMTP_HOST está definido
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu@email.com
# SMTP_PASS=app_password

# ── Billing ───────────────────────────────────────────────────────────────────
# Email del administrador para recibir alertas de billing (vencimientos, suspensiones)
# ADMIN_EMAIL=jeffersonm0915@gmail.com

# ── Rate limiting (opcional) ──────────────────────────────────────────────────
# RATE_LIMIT_PER_MINUTE=60     # tenant API (/api/whatsapp/*)
# PANEL_RATE_LIMIT=120          # panel dashboard (req/min por IP)
# WEBHOOK_VERIFY_RATE_LIMIT=15  # GET /webhook/:slug (handshake Meta)

# ── Seguridad avanzada ────────────────────────────────────────────────────────
# Whitelist de IPs para /admin/* (comma-separated). Vacío = sin restricción.
# Ejemplo: ADMIN_WHITELIST_IPS=1.2.3.4,5.6.7.8
# ADMIN_WHITELIST_IPS=

# ── IA conversacional (Anthropic) ────────────────────────────────────────────
# Habilita Claude Haiku como fallback cuando el flow no reconoce el input.
# Con AI_ENABLED=false o sin ANTHROPIC_API_KEY el bot funciona igual que antes.
ANTHROPIC_API_KEY=sk-ant-your-key-here
AI_ENABLED=true

# ── Plan Premium IA ───────────────────────────────────────────────────────────
# Transcripción de notas de voz con OpenAI Whisper (solo plan premium/enterprise)
OPENAI_API_KEY=sk-your-openai-key-here

# Hora UTC en que se envía el recordatorio de carrito abandonado (default: 9am UTC)
CART_RECOVERY_HOUR=9

# Hora UTC en que se envía el resumen diario al dueño (default: 8pm UTC)
DAILY_SUMMARY_HOUR=20

# ── Dominio (para el script de deploy + Certbot) ─────────────────────────────
DOMAIN=jestsolution.dev
CERTBOT_EMAIL=jeffersonm0915@gmail.com

# ── Panel de administración ───────────────────────────────────────────────────
# Firma JWT de access tokens del panel (mínimo 64 chars aleatorios)
# Generar: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
PANEL_JWT_SECRET=your_panel_jwt_secret_128_chars_hex

# HMAC-SHA256 para refresh tokens del panel (mínimo 64 chars aleatorios)
# Generar: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
PANEL_REFRESH_SECRET=your_panel_refresh_secret_128_chars_hex

# true en producción (requiere HTTPS), false en desarrollo local
PANEL_COOKIE_SECURE=true
