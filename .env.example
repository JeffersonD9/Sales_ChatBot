# ══════════════════════════════════════════════════════
#  WhatsApp SaaS — Variables de entorno (PRODUCCIÓN)
#  Copiar a .env y completar con valores reales.
#
#  Para desarrollo con Docker, usar .env.dev.example en su lugar.
# ══════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# ── Base de datos ─────────────────────────────────────────────────────────────
# PostgreSQL vive dentro del stack Docker como servicio `postgres`.
# No publiques el puerto 5432 en produccion; la conexion es solo por red interna.
POSTGRES_USER=app
POSTGRES_DB=postgres
PLATFORM_DB_NAME=platform
TENANT_DB_NAME_DEFAULT=tenant_shared_low
DATABASE_URL=postgresql://app:CHANGE_PASSWORD@postgres:5432/platform
PLATFORM_DATABASE_URL=postgresql://app:CHANGE_PASSWORD@postgres:5432/platform
TENANT_DATABASE_URL_DEFAULT=postgresql://app:CHANGE_PASSWORD@postgres:5432/tenant_shared_low
TENANT_DB_POOL_MAX=10
TENANT_DB_POOL_CACHE_MAX=20
DB_PASSWORD=CHANGE_PASSWORD

# ── Redis ─────────────────────────────────────────────────────────────────────
# Redis vive en este stack como servicio `redis`.
# La URL incluye la contraseña: redis://:PASSWORD@redis:6379
# Generar: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
REDIS_PASSWORD=your_redis_password_here
REDIS_URL=redis://:your_redis_password_here@redis:6379
REDIS_TLS=false

# ── Seguridad ─────────────────────────────────────────────────────────────────
# Secret de tu Meta App (developers.facebook.com → App → Configuración básica → Secreto)
META_APP_SECRET=your_meta_app_secret_here

# Proveedor de salida WhatsApp por defecto: meta o 360dialog.
# En 360dialog, el token del tenant debe ser la D360-API-KEY del numero/canal.
WHATSAPP_PROVIDER=meta
D360_BASE_URL=https://waba-v2.360dialog.io
# D360_API_KEY=solo_para_desarrollo_o_un_tenant_unico
# Opcional: header Authorization esperado en webhooks 360dialog.
# Debe coincidir con el header configurado en 360dialog Hub.
# D360_WEBHOOK_AUTHORIZATION=Basic base64_usuario_password

# Anti-ban WhatsApp. Mantener activo en produccion.
WHATSAPP_ANTIBAN_ENABLED=true
# Maximo de mensajes salientes consecutivos al mismo usuario sin respuesta.
WHATSAPP_MAX_OUTBOUND_WITHOUT_REPLY=3
# Limite base por numero; el guard usa 80% inicial y jitter aleatorio.
WHATSAPP_MAX_RATE_PER_MIN=60
# Ventana horaria opcional por zona local del destinatario. Para soporte 24/7 dejar false.
WHATSAPP_SEND_WINDOW_ENABLED=false
WHATSAPP_SEND_WINDOW_START=9
WHATSAPP_SEND_WINDOW_END=20

# AES-256 para encriptar wa_token en tabla tenants (32 bytes en hex = 64 chars)
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_64_char_hex_key_here

# pgcrypto para tenant_whatsapp_config (mínimo 32 caracteres)
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=your_app_secret_here

# API key para /admin/* (solo tú)
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=your_admin_api_key_here

# Firma JWT para tokens de tenant en /api/whatsapp/*
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# ── Demo mode ─────────────────────────────────────────────────────────────────
# true = sin DB ni Meta API para desarrollo controlado
DEMO_MODE=false

# Configuración del tenant demo (solo aplica con DEMO_MODE=true)
DEMO_SLUG=demo-store
DEMO_BUSINESS_NAME=Glamour Store (Demo)
DEMO_OWNER_PHONE=573001234567
DEMO_CITY=Bucaramanga
DEMO_SCHEDULE=Lun-Sab 9am-7pm

# ── Email (opcional) ──────────────────────────────────────────────────────────
# Solo se inicializa si SMTP_HOST está definido
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu@email.com
# SMTP_PASS=app_password

# ── Billing ───────────────────────────────────────────────────────────────────
# Email del administrador para recibir alertas de billing (vencimientos, suspensiones)
# ADMIN_EMAIL=jeffersonm0915@gmail.com

# ── Rate limiting (opcional) ──────────────────────────────────────────────────
# RATE_LIMIT_PER_MINUTE=60     # tenant API (/api/whatsapp/*)
# PANEL_RATE_LIMIT=120          # panel dashboard (req/min por IP)
# WEBHOOK_VERIFY_RATE_LIMIT=15  # GET /webhook/:slug (handshake Meta)

# Colas. En produccion el compose fuerza QUEUE_MODE=bullmq para webhooks.
# Usa AI_QUEUE_MODE=bullmq solo si levantas tambien el perfil `--profile ai`.
QUEUE_MODE=bullmq
AI_QUEUE_MODE=direct

# ── Seguridad avanzada ────────────────────────────────────────────────────────
# Whitelist de IPs para /admin/* (comma-separated). Vacío = sin restricción.
# Ejemplo: ADMIN_WHITELIST_IPS=1.2.3.4,5.6.7.8
# ADMIN_WHITELIST_IPS=

# ── IA conversacional ───────────────────────────────────────────────────────
# Gemini es el proveedor por defecto por costo/latencia para ventas por WhatsApp.
# Alternativas soportadas: AI_PROVIDER=gemini o AI_PROVIDER=anthropic.
# Con AI_ENABLED=false el bot funciona solo con el flow deterministico.
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_API_KEY=your_gemini_api_key_here
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_API_KEY=sk-ant-your-key-here
AI_ENABLED=true

# ── Plan Premium IA ───────────────────────────────────────────────────────────
# Transcripción de notas de voz con OpenAI Whisper (solo plan premium/enterprise)
OPENAI_API_KEY=sk-your-openai-key-here

# Hora UTC en que se envía el recordatorio de carrito abandonado (default: 9am UTC)
CART_RECOVERY_HOUR=9

# Hora UTC en que se envía el resumen diario al dueño (default: 8pm UTC)
DAILY_SUMMARY_HOUR=20

# Scheduler premium de carritos/resumen diario.
# En produccion queda apagado por defecto porque requiere compatibilidad multi-DB completa.
# Activar solo si el tenant corre en DB unica o despues de migrar premiumScheduler a tenant DBs.
ENABLE_PREMIUM_SCHEDULER=false

# ── Dominios (para nginx + Certbot) ──────────────────────────────────────────
# DOMAIN      → dominio principal del bot (webhooks y API)
# ADMIN_DOMAIN → dominio del panel admin (dashboard Next.js)
DOMAIN=jestsolution.tech
ADMIN_DOMAIN=admin.jestsolution.tech
CERTBOT_EMAIL=jeffersonm0915@gmail.com

# ── CORS (para /api/whatsapp) ─────────────────────────────────────────────────
# Orígenes permitidos para llamadas cross-origin a /api/whatsapp/*.
# Dejar vacío en desarrollo (permite cualquier origen).
# En producción: lista CSV de dominios exactos que integran la API.
# Ejemplo: https://cliente1.com,https://app.cliente2.io
ALLOWED_ORIGINS=

# ── HSTS ──────────────────────────────────────────────────────────────────────
# Tiempo en segundos del header Strict-Transport-Security (solo en NODE_ENV=production).
# Default: 31536000 (1 año). 0 desactiva el header.
# HSTS_MAX_AGE=31536000

# ── Panel de administración ───────────────────────────────────────────────────
# Firma JWT de access tokens del panel (mínimo 64 chars aleatorios)
# Generar: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
PANEL_JWT_SECRET=your_panel_jwt_secret_128_chars_hex

# HMAC-SHA256 para refresh tokens del panel (mínimo 64 chars aleatorios)
# Generar: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
PANEL_REFRESH_SECRET=your_panel_refresh_secret_128_chars_hex

# true en producción (requiere HTTPS), false en desarrollo local
PANEL_COOKIE_SECURE=true

# ── Dashboard Next.js (servicio separado) ────────────────────────────────────
# Secret de sesión para el panel admin (mínimo 32 chars)
# Generar: openssl rand -hex 32
DASHBOARD_AUTH_SECRET=replace_with_openssl_rand_hex_32

# Duración de sesión del panel en segundos (28800 = 8 horas)
DASHBOARD_SESSION_TTL_SECONDS=28800

# IPs separadas por coma que pueden acceder al panel (vacío = sin restricción)
# Recomendado en producción: limitar a tu IP fija
DASHBOARD_ALLOWED_IPS=
