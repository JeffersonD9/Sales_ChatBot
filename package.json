{
  "name": "whatsapp-saas",
  "version": "1.0.0",
  "type": "module",
  "description": "Plataforma SaaS multitenant de bots de ventas WhatsApp — Jest Solution",
  "main": "apps/api-core/server.js",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "npm run start:api",
    "dev": "npm run dev:api",
    "start:api": "node apps/api-core/server.js",
    "dev:api": "nodemon apps/api-core/server.js",
    "start:whatsapp": "node apps/wa-session-manager/server.js",
    "dev:whatsapp": "nodemon apps/wa-session-manager/server.js",
    "start:worker": "node apps/message-worker/index.js",
    "dev:worker": "nodemon apps/message-worker/index.js",
    "start:ai-worker": "node apps/ai-orchestrator/index.js",
    "dev:ai-worker": "nodemon apps/ai-orchestrator/index.js",
    "import-products": "node scripts/import-products.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --forceExit",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch --forceExit",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --forceExit",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit --forceExit",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/integration --forceExit"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "clearMocks": true,
    "verbose": true
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.92.0",
    "axios": "^1.7.2",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.76.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "express": "^4.19.2",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^11.3.5",
    "nodemailer": "^6.9.13",
    "pg": "^8.12.0",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0"
  }
}
