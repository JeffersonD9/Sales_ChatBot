# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
NEXT_PUBLIC_APP_URL=https://admin.jestsolution.dev

# ─── Base de datos ────────────────────────────────────────────────────────────
# DATABASE_URL       → base 'platform'  (tenants, panel auth, billing)
# TENANT_DATABASE_URL → base 'tenant_shared_low' (orders, sessions, products, messages)
#
# Usuarios con permisos restringidos — ver scripts/setup-db-permissions*.sql
#
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://dashboard_app:STRONG_PASSWORD_HERE@localhost:5432/platform
TENANT_DATABASE_URL=postgresql://dashboard_ro:STRONG_PASSWORD_HERE@localhost:5432/tenant_shared_low

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generar con: openssl rand -hex 32
AUTH_SECRET=replace_with_output_of_openssl_rand_hex_32

# Duración de sesión en segundos (28800 = 8 horas)
SESSION_TTL_SECONDS=28800

# ─── Seguridad ────────────────────────────────────────────────────────────────
# IPs separadas por coma que pueden acceder al panel (vacío = sin restricción).
# En producción: limitar a tu IP fija o la red interna del VPS.
ALLOWED_IPS=

# ─── Dominios ─────────────────────────────────────────────────────────────────
PANEL_DOMAIN=admin.jestsolution.dev
BOT_DOMAIN=bot.jestsolution.dev
