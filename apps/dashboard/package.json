{
  "name": "jestsolution-dashboard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start -p ${PORT:-3001}",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "docker:build": "docker build -t jestsolution/dashboard:latest .",
    "docker:up": "docker compose -f docker-compose.dev.yml up -d",
    "docker:down": "docker compose -f docker-compose.dev.yml down",
    "docker:prod": "docker compose -f docker-compose.prod.yml up -d --build",
    "admin:create": "dotenv -e .env.local -- tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "next": "15.3.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "drizzle-orm": "0.43.1",
    "pg": "8.13.3",
    "@node-rs/argon2": "2.0.0",
    "@sentry/nextjs": "^10.53.1",
    "nanoid": "5.1.5",
    "zod": "3.24.3",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-query": "5.74.4",
    "react-hook-form": "7.55.0",
    "@hookform/resolvers": "5.0.1",
    "recharts": "2.15.3",
    "lucide-react": "0.511.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "2.6.0",
    "date-fns": "4.1.0",
    "sonner": "1.7.4",
    "tw-animate-css": "1.2.9",
    "ioredis": "^5.3.2"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "@types/react": "19.1.4",
    "@types/react-dom": "19.1.3",
    "@types/node": "22.15.21",
    "@types/pg": "8.11.11",
    "tailwindcss": "4.1.6",
    "@tailwindcss/postcss": "4.1.6",
    "postcss": "8.5.3",
    "@biomejs/biome": "1.9.4",
    "drizzle-kit": "0.30.4",
    "dotenv-cli": "7.4.4",
    "tsx": "4.19.2"
  }
}
