# Template procesado por envsubst al iniciar el contenedor.
# Variable requerida: DOMAIN (ej: api.midominio.com)
# El resultado se coloca en /etc/nginx/conf.d/default.conf

# HTTP: responde ACME challenge y redirige todo lo demás a HTTPS
server {
  listen 80;
  server_name ${DOMAIN};

  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  location = /health {
    proxy_pass http://api:3000;
    proxy_set_header Host $host;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

# HTTPS principal
server {
  listen 443 ssl;
  http2  on;
  server_name ${DOMAIN};

  ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
  ssl_protocols       TLSv1.2 TLSv1.3;
  ssl_ciphers         ECDHE-RSA-AES128-GCM-SHA256:HIGH:!aNULL:!MD5;
  ssl_prefer_server_ciphers on;
  ssl_session_cache   shared:SSL:10m;
  ssl_session_timeout 1d;

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

  # Webhooks Meta — rutas /webhook/:slug con rate limit propio
  location ~ ^/webhook/[a-z0-9_-]+$ {
    limit_req zone=webhook burst=50 nodelay;
    proxy_pass         http://whatsapp:3001;
    proxy_set_header   Host              $host;
    proxy_set_header   X-Real-IP         $remote_addr;
    proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Proto https;
    proxy_read_timeout 10s;
    proxy_connect_timeout 5s;
  }

  # Media: solo accesible via X-Accel-Redirect emitido por el app (requiere JWT)
  location /media/ {
    internal;
    alias   /var/whatsapp-saas/media/;
    expires 30d;
    add_header Cache-Control        "public, immutable";
    add_header X-Content-Type-Options "nosniff" always;
  }

  # Todo lo demás → API Core
  location / {
    proxy_pass       http://api:3000;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
  }
}
